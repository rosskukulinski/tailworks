{
  // e2e/dataplane cron loop (#419): the stateless cron workload. The
  // "reschedule" fault swaps "* * * * *" for "*/2 * * * *" and back
  // (cron_test.go cronSwap).
  "name": "cron",
  "main": "src/index.js",
  "compatibility_date": "2026-04-01",
  "triggers": {
    "crons": [
      "* * * * *",
      "*/1 * * * *",
      "0-59 * * * *",
    ],
  },
  "vars": { "REC": "http://rec.invalid" },
}
