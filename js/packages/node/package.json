{
  "name": "@tailworks/node",
  "version": "0.5.0",
  "description": "tw Node process tier SDK: verified caller (x-tw-caller), attributed egress (proxy fetch / undici dispatcher)",
  "keywords": [
    "tw",
    "tailscale",
    "node"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "undici": ">=6"
  },
  "peerDependenciesMeta": {
    "undici": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "node --test test/*.test.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosskukulinski/tailworks.git",
    "directory": "js/packages/node"
  },
  "homepage": "https://github.com/rosskukulinski/tailworks#readme",
  "bugs": "https://github.com/rosskukulinski/tailworks/issues",
  "license": "BSD-3-Clause"
}
