{
  "name": "r2",
  "main": "src/index.js",
  "compatibility_date": "2026-04-01",
  // Hold makes the workload stateful (fenced): a host cut off from mgmt
  // stops it after 30 s (docs/r2.md). The r2-replicas scenario deploys
  // this bundle without it, with "replicas": 2 (r2_test.go).
  "durable_objects": { "bindings": [{ "name": "HOLD", "class_name": "Hold" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hold"] }],
  "r2_buckets": [{ "binding": "B", "bucket_name": "chaos" }],
}
