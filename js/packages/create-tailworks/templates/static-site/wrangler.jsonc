{
  "name": "static-site",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "assets": {
    // the folder served as the site (index.html, style.css, …); `tw dev`
    // reloads when a file in it changes
    "directory": "./public",
    // env.ASSETS.fetch(req) serves a file from the Worker
    "binding": "ASSETS",
    // these paths run the Worker first: it answers /api/*, and checks the
    // caller before it serves the files under /team/
    "run_worker_first": ["/api/*", "/team/*"],
    // a path with no file (and no Worker answer) gets public/404.html
    "not_found_handling": "404-page"
  }
}
