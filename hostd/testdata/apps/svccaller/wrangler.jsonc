{
  "name": "svccaller",
  "main": "src/index.js",
  "compatibility_date": "2026-04-01",
  "services": [
    { "binding": "B", "service": "svctarget" },
    { "binding": "ADMIN", "service": "svctarget", "entrypoint": "Admin" },
    { "binding": "GHOST", "service": "nosuchworkload" },
  ],
  "durable_objects": { "bindings": [{ "name": "AGENT", "class_name": "Agent" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Agent"] }],
  "vars": { "TARGET_HOST": "" },
}
