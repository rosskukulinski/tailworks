{
  // SDK conformance (e2e/sdk/oauthkv_test.go): @cloudflare/workers-oauth-provider
  // unmodified, with its OAUTH_KV on tailworks' Workers KV binding.
  "name": "oauthkv",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "oauth" }],
}
