{
  "name": "@tailworks/tailnet",
  "version": "0.5.0",
  "description": "Verified tailnet caller identity and per-object egress for tailworks Workers and Durable Objects",
  "keywords": [
    "tw",
    "tailscale",
    "tailnet",
    "workers",
    "durable-objects"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./testing/dev": {
      "types": "./dist/testing-dev.d.ts",
      "default": "./dist/testing-dev.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "node --test test/*.test.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosskukulinski/tailworks.git",
    "directory": "js/packages/tailnet"
  },
  "homepage": "https://github.com/rosskukulinski/tailworks#readme",
  "bugs": "https://github.com/rosskukulinski/tailworks/issues",
  "license": "BSD-3-Clause"
}
